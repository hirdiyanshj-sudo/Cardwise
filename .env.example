# ==========================================
# CardWise – Smart Credit Card Manager
# Environment Configuration Example
# ==========================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false

# Security & Authentication
# REQUIRED in production (min 32 characters; server refuses startup if weak/missing)
JWT_SECRET=replace-with-a-strong-random-64-char-secret-in-production
ENCRYPTION_KEY=replace-with-a-32-byte-hex-or-passphrase-for-aes-256
COOKIE_SECURE=false

# Database Mode
# Leave DATABASE_URL blank to use local zero-config SQLite (backend/data/cardwise.db)
# Provide PostgreSQL / Supabase connection string for production PostgreSQL mode
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Required in production for Google Sign-In; leave blank in dev if unused)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email Service (SMTP - required for real email delivery confirmation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cardwise.in

# Optional Admin Bootstrap (set to seed or elevate an administrator account on startup)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional SMS Gateway (Twilio / MSG91 - disabled unless configured)
SMS_PROVIDER=
SMS_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
